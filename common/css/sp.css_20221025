.side--menu {
  margin: 0 -15px;
  background: url(../../images/sidemenu_bg.gif) 0 0;
  border-bottom: 1px solid #ccc;
}
.side--menu h3 {
  padding: 12px 0;
  color: #09483e;
  font-size: 1.4rem;
  font-weight: bold;
  text-align: center;
  line-height: 1.0;
  position: relative;
}
.side--menu h3:after {
  content: '\f107';
  font-family: FontAwesome;
  font-size: 2.0rem;
  position: absolute;
  right: 15px;
}
.side--menu ul {
  max-height: 0;
  -webkit-opacity: 0;
  -moz-opacity: 0;
  -ms-opacity: 0;
  -o-opacity: 0;
  opacity: 0;
  overflow: hidden;
  -webkit-transition: all 0.5s;
  -o-transition: all 0.5s;
  transition: all 0.5s;
}
.side--menu ul li {
  border-top: 1px solid #ccc;
}
.side--menu ul li a {
  display: block;
  color: #333;
  padding: 15px;
}
.side--menu ul ul {
  background: #fff;
  -webkit-box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
  box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.2);
}
.side--menu ul ul li a {
  color: #666;
}
.side--menu ul.side--menu--open {
  max-height: 80em;
  -webkit-opacity: 1;
  -moz-opacity: 1;
  -ms-opacity: 1;
  -o-opacity: 1;
  opacity: 1;
  -webkit-transition: all 0.5s;
  -o-transition: all 0.5s;
  transition: all 0.5s;
}
.side--menu ul.side--menu--open ul {
  max-height: 50em;
  -webkit-opacity: 1;
  -moz-opacity: 1;
  -ms-opacity: 1;
  -o-opacity: 1;
  opacity: 1;
}

