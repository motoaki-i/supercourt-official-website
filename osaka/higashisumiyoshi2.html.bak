                    <th scope="row">居室数</th>
                    <td> 77室 </td>
                    <th>定員</th>
                    <td> 77名 </td>
                  </tr>
                  <tr>
                    <th scope="row">共用施設</th>
                    <td> 食堂、浴室、特浴室、共用トイレ </td>
                    <th>入居条件</th>
                    <td> 要介護1～5、要支援1・2の方 </td>
                  </tr>
                  <tr>
                    <th scope="row">権利関係</th>
                    <td> 利用権 </td>
                    <th>契約期間中退去</th>
                    <td> 可能 </td>
                  </tr>
                </tbody>
              </table>
