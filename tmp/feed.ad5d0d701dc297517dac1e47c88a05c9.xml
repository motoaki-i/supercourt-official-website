    <category term="ハロウィン" label="ハロウィン" scheme="http://www.sixapart.com/ns/types#tag" />
    <category term="ハロウィンパーティ" label="ハロウィンパーティ" scheme="http://www.sixapart.com/ns/types#tag" />
