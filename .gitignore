# WordPress本体のシステムフォルダを除外
/wp-admin/
/wp-includes/
/*.php

# プラグインやコアのアップデートファイル、キャッシュなどを除外
/wp-content/plugins/
/wp-content/cache/
/wp-content/upgrade/

# All-in-One WP Migration backup files
/wordpress/wp-content/ai1wm-backups/

# 設定ファイルや環境依存ファイルを除外
/wp-config.php
/.htaccess
