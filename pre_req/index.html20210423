<!--希望連絡先切り替え-->
          <style>
		.dispnone {
			display: none;
		}
		</style>
          <script>
$(function(){
   $( 'input[name="希望連絡先(必須)"]:radio' ).change( function() {
      var radioval = $(this).val();
      if(radioval == 'メール'){
          $('#tel_id').removeAttr('name');
          $('#mail_id').attr('name','email(必須)'); 
		  $('.hissumail').removeClass('dispnone');
		  $('.hissutel').addClass('dispnone');

      }else{
          $('#tel_id').attr('name','電話番号(必須)'); 
          $('#mail_id').removeAttr('name');
		  $('.hissumail').addClass('dispnone');
		  $('.hissutel').removeClass('dispnone');
      }
   }); 
});
</script> 
